# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / CDK
node_modules/
cdk.out/
*.tsbuildinfo

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log

# Secrets & credentials — nothing in these shapes ever gets committed
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials
*.tfvars
!example.tfvars

# Local artifacts
.DS_Store
*.db
*.sqlite3
audit-*.jsonl

# Upstream reference repositories — studied, never vendored.
# See platform/docs/references.md for what was taken from each.
.reference/

# Discovery: raw snapshots carry real account IDs, ARNs and emails.
# Only the redacted snapshot under platform/00-discovery/snapshots/ is committed.
platform/00-discovery/snapshots/raw/
platform/00-discovery/report/*.local.md

# Observability: local stack state and credentials
platform/19-observability/**/.env
platform/19-observability/data/
